MODULE    = wineios.drv
UNIXLIB   = wineios.so
IMPORTS   = user32 gdi32 win32u
UNIX_LIBS = -lwin32u -framework CoreGraphics -framework Foundation -framework QuartzCore -framework UIKit

VER_FILEDESCRIPTION_STR = "Wine iOS driver"

SOURCES = \
	control.c \
	dllmain.c \
	ipc.c \
	iosdrv.c \
	wineios.drv.spec
