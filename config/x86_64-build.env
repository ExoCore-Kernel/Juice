# Pinned, audited inputs for the optional Hangover/FEX x86-64 path.
#
# llvm-mingw publishes separate Linux host archives.  Keep the guest toolchain
# revision pinned while selecting the archive that can actually execute on the
# build host.  Both archives below come from the same bylaws/llvm-mingw release.
JUICE_FEX_REPOSITORY=${JUICE_FEX_REPOSITORY:-https://github.com/AndreRH/FEX.git}
JUICE_FEX_REVISION=${JUICE_FEX_REVISION:-86ff33bbe299cd8959a6610198c169b67ec419db}
JUICE_LLVM_MINGW_VERSION=${JUICE_LLVM_MINGW_VERSION:-20250920}

case "${JUICE_LLVM_MINGW_HOST_ARCH:-$(uname -m)}" in
  x86_64|amd64)
    JUICE_LLVM_MINGW_HOST_ARCH=x86_64
    _juice_default_archive="llvm-mingw-${JUICE_LLVM_MINGW_VERSION}-ucrt-ubuntu-22.04-x86_64.tar.xz"
    _juice_default_sha256="8dd8c34fc051a50c2fae86015f35057f8aae93fe1e19b34537ef1269a8b4c772"
    ;;
  aarch64|arm64)
    JUICE_LLVM_MINGW_HOST_ARCH=aarch64
    _juice_default_archive="llvm-mingw-${JUICE_LLVM_MINGW_VERSION}-ucrt-ubuntu-22.04-aarch64.tar.xz"
    _juice_default_sha256="bce5cc755c613515fd44e1ee9523123d854103abae147571adb645450036274d"
    ;;
  *)
    echo "Unsupported Linux host architecture for llvm-mingw: $(uname -m)" >&2
    return 2 2>/dev/null || exit 2
    ;;
esac

JUICE_LLVM_MINGW_ARCHIVE=${JUICE_LLVM_MINGW_ARCHIVE:-$_juice_default_archive}
JUICE_LLVM_MINGW_SHA256=${JUICE_LLVM_MINGW_SHA256:-$_juice_default_sha256}
JUICE_LLVM_MINGW_URL=${JUICE_LLVM_MINGW_URL:-https://github.com/bylaws/llvm-mingw/releases/download/${JUICE_LLVM_MINGW_VERSION}/${JUICE_LLVM_MINGW_ARCHIVE}}
JUICE_LLVM_MINGW_DIRNAME=${JUICE_LLVM_MINGW_DIRNAME:-${JUICE_LLVM_MINGW_ARCHIVE%.tar.xz}}
unset _juice_default_archive _juice_default_sha256
