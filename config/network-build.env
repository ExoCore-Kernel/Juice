# Reproducible native networking dependency pins.
#
# Wine's secur32 Unix side dlopens this exact path from the Grape loader. The
# relative path reaches Juice.app/Libraries from either Grape runtime without
# requiring GnuTLS to be installed in /var/jb on the destination device.
JUICE_GNUTLS_VERSION=3.8.5
JUICE_GNUTLS_SONAME=libgnutls.30.dylib
JUICE_GNUTLS_RUNTIME_NAME=@executable_path/../../../../Libraries/libgnutls.30.dylib
JUICE_NETWORK_DEPS_VERSION=1
