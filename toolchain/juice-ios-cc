#!/usr/bin/env bash
set -euo pipefail

# Front-end for the cctools-port iOS cross toolchain. The compiler itself is a
# native Linux executable; only its output is arm64 Mach-O for iOS.
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
TOOLCHAIN="${JUICE_IOS_TOOLCHAIN:-$ROOT/build/ios-toolchain}"
PREFIX="${JUICE_IOS_TRIPLE_PREFIX:-arm-apple-darwin11}"
MIN_IOS="${JUICE_MIN_IOS:-14.0}"

# cctools-port's compiler wrapper expects its sibling linker/tools on PATH.
# Its Linux-hosted linker also loads helper libraries (notably
# libBlocksRuntime.so) from the toolchain prefix at runtime. Keep both paths
# scoped to this compiler process so callers do not need to configure them.
export PATH="$TOOLCHAIN/bin${PATH:+:$PATH}"
host_lib_path=""
for dir in "$TOOLCHAIN/lib" "$TOOLCHAIN/lib64"; do
  if test -d "$dir"; then
    host_lib_path="${host_lib_path:+$host_lib_path:}$dir"
  fi
done
if test -n "$host_lib_path"; then
  export LD_LIBRARY_PATH="$host_lib_path${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

case "$(basename "$0")" in
  *cxx*|*++*) REAL_COMPILER="${JUICE_IOS_CCTOOLS_CXX:-$TOOLCHAIN/bin/$PREFIX-clang++}" ;;
  *)         REAL_COMPILER="${JUICE_IOS_CCTOOLS_CC:-$TOOLCHAIN/bin/$PREFIX-clang}" ;;
esac

test -x "$REAL_COMPILER" || {
  cat >&2 <<MSG
Missing Linux iOS cross compiler: $REAL_COMPILER
Build cctools-port's usage_examples/ios_toolchain for arm64, then set:
  export JUICE_IOS_TOOLCHAIN=/absolute/path/to/its/target
MSG
  exit 2
}

if test -n "${IOS_SDK:-}"; then
  test -d "$IOS_SDK" || { echo "Missing iPhoneOS SDK: $IOS_SDK" >&2; exit 2; }
  export IOS_SDK_SYSROOT="$IOS_SDK"
fi
export IOS_TARGET_CPU="${IOS_TARGET_CPU:-arm64}"
export IPHONEOS_DEPLOYMENT_TARGET="$MIN_IOS"

# Keep iOS-only compatibility code scoped to the translation units that need
# it. virtual.c gets the MAP_TRYFIXED adapter. loader/main.c gets a constructor
# that asks the optional jailbreak helper to lower only the Grape-X64 child's
# vm_map minimum before Wine starts allocating its WoW64 address space.
extra_args=()
link_extra_args=()
cache_shim_source="$ROOT/scripts/ios-clear-cache-shim.c"
cache_shim_obj="$ROOT/build/ios-shims/clear-cache.o"
ntdll_link=0
cache_shim_present=0

for arg in "$@"; do
  case "$arg" in
    */dlls/ntdll/unix/virtual.c|dlls/ntdll/unix/virtual.c)
      extra_args=(-include "$ROOT/toolchain/juice-ios-map-tryfixed.h")
      ;;
    */loader/main.c|loader/main.c)
      extra_args=(-DJUICE_IOS_LOWVA_BOOTSTRAP=1 -include "$ROOT/toolchain/juice-ios-lowva-bootstrap.h")
      ;;
  esac

  case "$arg" in
    */dlls/ntdll/ntdll.so|dlls/ntdll/ntdll.so)
      ntdll_link=1
      ;;
    "$cache_shim_obj"|*/build/ios-shims/clear-cache.o|build/ios-shims/clear-cache.o)
      cache_shim_present=1
      ;;
  esac
done

# Some generated Wine link rules do not consistently preserve an LDFLAGS+=
# object injected by the outer build script. virtual.c can legitimately lower
# __builtin___clear_cache() to an external ___clear_cache reference under the
# Linux-hosted cctools toolchain, so make the compiler wrapper itself guarantee
# that the compatibility object is present on the native ntdll.so link.
#
# A clean build may reach ntdll.so indirectly while preparing another Unixlib
# (notably the static-FreeType DirectWrite path) before build-wine-linux.sh has
# created the shim. Build it lazily here with the underlying compiler. Using
# REAL_COMPILER avoids recursing back through this wrapper, while the SDK and
# deployment-target environment above is identical to an ordinary wrapper
# compile. This makes every generated Wine dependency path self-contained.
if test "$ntdll_link" = 1 && test "$cache_shim_present" = 0; then
  test -f "$cache_shim_source" || {
    echo "Missing iOS clear-cache shim source: $cache_shim_source" >&2
    exit 3
  }
  if test ! -f "$cache_shim_obj" || test "$cache_shim_source" -nt "$cache_shim_obj"; then
    mkdir -p "$(dirname "$cache_shim_obj")"
    echo "JUICE_IOS_CACHE_SHIM_AUTOBUILD output=$cache_shim_obj" >&2
    "$REAL_COMPILER" -c "$cache_shim_source" -o "$cache_shim_obj"
  fi
  link_extra_args+=("$cache_shim_obj")
  echo "JUICE_IOS_CACHE_SHIM_LINK target=dlls/ntdll/ntdll.so object=$cache_shim_obj" >&2
fi

exec "$REAL_COMPILER" "${extra_args[@]}" "$@" "${link_extra_args[@]}"
