+/*
+ * Allocate memory that contains native ARM64EC code without requiring it to
+ * start life writable+executable.  iOS requires a strict RW -> RX transition,
+ * while the ARM64EC process bitmap still has to distinguish FEX's generated
+ * host code from the x86-64 guest address space.
+ */
+inline void* VirtualAllocECCode(void* Base, size_t Size, bool Execute = false, bool Commit = true) {
+#ifdef ARCHITECTURE_arm64ec
+  DWORD Flags = (Commit ? MEM_COMMIT : 0) | MEM_RESERVE | MEM_TOP_DOWN;
+  MEM_EXTENDED_PARAMETER Parameter {};
+  Parameter.Type = MemExtendedParameterAttributeFlags;
+  Parameter.ULong64 = MEM_EXTENDED_PARAMETER_EC_CODE;
+  return ::VirtualAlloc2(nullptr, Base, Size, Flags, Execute ? PAGE_EXECUTE_READWRITE : PAGE_READWRITE, &Parameter, 1);
+#else
+  return VirtualAlloc(Base, Size, Execute, Commit);
+#endif
+}
+
+inline void* VirtualAllocECCode(size_t Size, bool Execute = false, bool Commit = true) {
+  return VirtualAllocECCode(nullptr, Size, Execute, Commit);
