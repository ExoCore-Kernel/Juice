+void Arm64Emitter::ValidateCallRetStack(ARMEmitter::Register TmpReg) {
+#if defined(ARCHITECTURE_arm64ec) && defined(FEX_JUICE_IOS)
+  LOGMAN_THROW_A_FMT(TmpReg != REG_CALLRET_SP, "Call-ret validation needs a temporary register");
+
+  ARMEmitter::ForwardLabel ResetWithBase;
+  ARMEmitter::ForwardLabel Valid;
+
+  // Native ARM64EC transitions are allowed to clobber x17. FEX also pins x17
+  // as its call-ret shadow-stack pointer, so reject a native value before it
+  // can be persisted into CPUState or dereferenced on the next JIT entry.
+  ldr(TmpReg.X(), ARMEmitter::XReg::x18, TEB_CPU_AREA_OFFSET);
+  ldr(TmpReg.X(), TmpReg.X(), CPU_AREA_THREAD_STATE_OFFSET);
+  ldr(TmpReg.X(), TmpReg.X(), offsetof(FEXCore::Core::InternalThreadState, CallRetStackBase));
+
+  cmp(ARMEmitter::Size::i64Bit, REG_CALLRET_SP, TmpReg);
+  (void)b(ARMEmitter::Condition::CC_CC, &ResetWithBase);
+
+  add(ARMEmitter::Size::i64Bit, TmpReg, TmpReg, FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE);
+  cmp(ARMEmitter::Size::i64Bit, REG_CALLRET_SP, TmpReg);
+  (void)b(ARMEmitter::Condition::CC_CC, &Valid);
+
+  sub(ARMEmitter::Size::i64Bit, TmpReg, TmpReg, FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE);
+  (void)Bind(&ResetWithBase);
+  add(ARMEmitter::Size::i64Bit, REG_CALLRET_SP, TmpReg, FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE / 4);
+  str(REG_CALLRET_SP, STATE.R(), offsetof(FEXCore::Core::CpuStateFrame, State.callret_sp));
+
+  (void)Bind(&Valid);
+#else
+  (void)TmpReg;
+#endif
+}
