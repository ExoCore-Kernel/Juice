* text=auto
*.c text eol=lf
*.h text eol=lf
*.m text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.plist text eol=lf
*.reg text eol=crlf
*.dll binary
*.exe binary
*.nls binary
*.png binary
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
releases/*.tipa filter=lfs diff=lfs merge=lfs -text

# Device proof artifacts are checksummed byte-for-byte. Keep their original
# iOS/Windows line endings and trailing diagnostic whitespace intact.
proofs/**/*.log binary
proofs/**/*.ok binary
proofs/**/*.marker binary
proofs/**/*.txt binary
proofs/**/*.env binary
proofs/**/*.cfg binary
